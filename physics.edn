;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a logistics-coordination robot performs
;; catch/harvest record entry, equipment-maintenance scheduling and non-weapon
;; equipment/supplies procurement paperwork for subsistence fishers, hunters,
;; trappers and gatherers (ISCO 6340). It never fishes, hunts, sets traps or
;; decides harvest timing. Its physical work is equipment logistics: carrying
;; maintained gear (nets, floats, containers) down to the landing, and
;; lifting a gear crate into the boat or vehicle.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6340"
 :cases
 [{:id :gear-to-landing
   :kind :transport
   :procedure "logistics robot carries maintained non-weapon gear (nets, floats, containers) along a sandy path down to the landing"
   :params {:mass-kg 60.0 :distance-m 150.0 :v-max-mps 0.7 :a-max-mps2 0.25
            :brake-decel-mps2 0.5 :drive-force-n 200.0 :crr 0.15
            :cog-height-m 0.45 :support-half-length-m 0.35}
   :sweep {:param :payload-kg :values [10.0 20.0 40.0 60.0 80.0]}
   :quantity :cycle-time-s
   :limit {:max 300.0 :basis "estimate: gear must reach the landing within 5 minutes of the household's departure call"}
   :boundary {:lo 2.0 :hi 120.0}}
  {:id :gear-crate-into-boat
   :kind :manipulator
   :procedure "arm lifts a gear crate from the landing into the boat or vehicle"
   :params {:l1-m 0.55 :l2-m 0.45 :m1-kg 6.0 :m2-kg 4.0
            :from [0.65 0.10] :to [0.30 -0.30] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 10.0 15.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 100.0 :basis "estimate: continuous shoulder torque of a ~10 kg payload class arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
